{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oathbound.example/relay/schemas/peer-frame.schema.json",
  "title": "Live connection messages",
  "description": "Text messages on the live connection (GET /v1/socket). See constants.json socketAuth and peerMessage. The relay reads only the routing fields of a send; nonce and ciphertext are opaque to it.",
  "oneOf": [
    { "$ref": "#/$defs/challenge" },
    { "$ref": "#/$defs/auth" },
    { "$ref": "#/$defs/authOk" },
    { "$ref": "#/$defs/send" },
    { "$ref": "#/$defs/frame" },
    { "$ref": "#/$defs/matchSend" },
    { "$ref": "#/$defs/matchFrame" },
    { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/hint" },
    { "$ref": "#/$defs/lfpHint" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "nonce22": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
    "side": { "enum": ["owner", "sub"] },
    "channel": { "description": "live (peerMessage, the default when absent) or chat (peerChat).", "enum": ["live", "chat"] },
    "header": {
      "type": "object",
      "required": ["pairIdHash", "pairEpoch", "from", "seq", "sentAt", "nonce", "ciphertext"],
      "properties": {
        "channel": { "$ref": "#/$defs/channel" },
        "pairIdHash": { "$ref": "common.schema.json#/$defs/pairIdHash" },
        "pairEpoch": { "$ref": "common.schema.json#/$defs/pairEpoch" },
        "from": { "$ref": "#/$defs/side" },
        "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sentAt": { "$ref": "common.schema.json#/$defs/unixSeconds" },
        "nonce": { "description": "AES-GCM nonce, 12 bytes base64url.", "type": "string", "pattern": "^[A-Za-z0-9_-]{16}$" },
        "ciphertext": { "description": "AES-GCM ciphertext with tag, base64url.", "type": "string", "pattern": "^[A-Za-z0-9_-]{22,10944}$" }
      }
    },
    "matchHeader": {
      "description": "Routing fields of a match chat message (constants.json matchChat).",
      "type": "object",
      "required": ["channel", "matchId", "from", "seq", "sentAt", "nonce", "ciphertext"],
      "properties": {
        "channel": { "const": "match" },
        "matchId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "from": { "enum": ["a", "b"] },
        "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sentAt": { "$ref": "common.schema.json#/$defs/unixSeconds" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16}$" },
        "ciphertext": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,10944}$" }
      }
    },
    "matchSend": {
      "description": "client -> relay: a match chat message for the other member of the match. Acks and receipts as for chat.",
      "type": "object", "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/matchHeader" }],
      "required": ["type", "id", "channel", "matchId", "from", "seq", "sentAt", "nonce", "ciphertext"],
      "properties": {
        "type": { "const": "send" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "safety": { "const": false },
        "channel": true, "matchId": true, "from": true, "seq": true, "sentAt": true, "nonce": true, "ciphertext": true
      }
    },
    "matchFrame": {
      "description": "relay -> client: a match chat message, exactly as sent minus id and safety.",
      "type": "object", "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/matchHeader" }],
      "required": ["type", "channel", "matchId", "from", "seq", "sentAt", "nonce", "ciphertext"],
      "properties": {
        "type": { "const": "frame" },
        "channel": true, "matchId": true, "from": true, "seq": true, "sentAt": true, "nonce": true, "ciphertext": true
      }
    },
    "lfpHint": {
      "description": "relay -> client: a match was made or ended, or a block changed this device's matches; fetch GET /v1/lfp/matches.",
      "type": "object", "additionalProperties": false,
      "required": ["type", "kind"],
      "properties": { "type": { "const": "hint" }, "kind": { "const": "lfp" } }
    },
    "matchPlaintext": {
      "description": "The decrypted ciphertext of a match-channel frame. role is what the receiver of an invite would become.",
      "type": "object",
      "required": ["v", "kind"],
      "oneOf": [
        { "properties": { "v": { "const": 1 }, "kind": { "const": "text" }, "text": { "type": "string", "minLength": 1, "maxLength": 1000 } }, "required": ["text"], "additionalProperties": false },
        { "properties": { "v": { "const": 1 }, "kind": { "const": "character" }, "name": { "type": "string", "minLength": 1, "maxLength": 32 }, "world": { "type": "string", "minLength": 1, "maxLength": 32 } }, "required": ["name", "world"], "additionalProperties": false },
        { "properties": { "v": { "const": 1 }, "kind": { "const": "invite" }, "code": { "type": "string", "minLength": 16, "maxLength": 24 }, "role": { "enum": ["owner", "sub"] } }, "required": ["code", "role"], "additionalProperties": false }
      ]
    },
    "challenge": {
      "description": "relay -> client, once on connect.",
      "type": "object", "additionalProperties": false,
      "required": ["type", "nonce", "serverTime"],
      "properties": {
        "type": { "const": "challenge" },
        "nonce": { "$ref": "#/$defs/nonce22" },
        "serverTime": { "$ref": "common.schema.json#/$defs/unixSeconds" }
      }
    },
    "auth": {
      "description": "client -> relay, signature over the socketAuth base string.",
      "type": "object", "additionalProperties": false,
      "required": ["type", "deviceKeyId", "signature"],
      "properties": {
        "type": { "const": "auth" },
        "deviceKeyId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
        "features": { "description": "What this client supports; \"chat\" lets the relay forward and store chat for it, \"match\" match chat (constants.json matchChat).", "type": "array", "items": { "enum": ["chat", "match"] }, "uniqueItems": true }
      }
    },
    "authOk": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "auth-ok" } }
    },
    "send": {
      "description": "client -> relay: forward to the other device of the pairing. safety is honoured only from the Sub side.",
      "type": "object", "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/header" }],
      "required": ["type", "id", "safety", "pairIdHash", "pairEpoch", "from", "seq", "sentAt", "nonce", "ciphertext"],
      "properties": {
        "type": { "const": "send" },
        "id": { "description": "Client-chosen id echoed in acks.", "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "safety": { "type": "boolean" },
        "channel": true,
        "pairIdHash": true, "pairEpoch": true, "from": true, "seq": true, "sentAt": true, "nonce": true, "ciphertext": true
      }
    },
    "frame": {
      "description": "relay -> client: a frame from the other device, exactly as sent minus id and safety.",
      "type": "object", "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/header" }],
      "required": ["type", "pairIdHash", "pairEpoch", "from", "seq", "sentAt", "nonce", "ciphertext"],
      "properties": {
        "type": { "const": "frame" },
        "channel": true,
        "pairIdHash": true, "pairEpoch": true, "from": true, "seq": true, "sentAt": true, "nonce": true, "ciphertext": true
      }
    },
    "ack": {
      "description": "relay -> client. held is followed later by a second ack for the same id with delivered or offline; stored (chat) by one with delivered or expired, kept for the sender until it reconnects.",
      "type": "object", "additionalProperties": false,
      "required": ["type", "id", "result"],
      "properties": {
        "type": { "const": "ack" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "result": { "enum": ["delivered", "held", "offline", "stored", "mailbox_full", "expired", "needs_update", "over_limit", "over_budget", "refused"] }
      }
    },
    "hint": {
      "description": "relay -> client: something on this pairing changed; run the pair status check for it.",
      "type": "object", "additionalProperties": false,
      "required": ["type", "pairIdHash", "pairEpoch"],
      "properties": {
        "type": { "const": "hint" },
        "pairIdHash": { "$ref": "common.schema.json#/$defs/pairIdHash" },
        "pairEpoch": { "$ref": "common.schema.json#/$defs/pairEpoch" }
      }
    },
    "error": {
      "description": "relay -> client before closing the connection.",
      "type": "object", "additionalProperties": false,
      "required": ["type", "code"],
      "properties": {
        "type": { "const": "error" },
        "code": { "enum": ["unauthorized", "invalid_request", "replaced"] }
      }
    },
    "chatPlaintext": {
      "description": "The decrypted ciphertext of a chat-channel frame.",
      "type": "object", "additionalProperties": false,
      "required": ["v", "kind", "text"],
      "properties": {
        "v": { "const": 1 },
        "kind": { "enum": ["chat", "image"] },
        "text": { "description": "Required (non-empty) for chat; an optional caption for image.", "type": "string", "maxLength": 1000 },
        "image": {
          "description": "kind image only. See constants.json peerChat.image.",
          "type": "object", "additionalProperties": false,
          "required": ["id", "key", "width", "height"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
            "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
            "width": { "type": "integer", "minimum": 1, "maximum": 1600 },
            "height": { "type": "integer", "minimum": 1, "maximum": 1600 }
          }
        }
      }
    },
    "plaintext": {
      "description": "The decrypted ciphertext of a live-channel frame.",
      "type": "object", "additionalProperties": false,
      "required": ["v", "kind", "text", "character"],
      "properties": {
        "v": { "const": 1 },
        "kind": { "enum": ["command", "notice"] },
        "text": { "type": "string", "minLength": 1 },
        "character": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["n", "w"],
              "properties": { "n": { "type": "string", "minLength": 1, "maxLength": 32 }, "w": { "type": "string", "minLength": 1, "maxLength": 32 } }
            }
          ]
        },
        "receipt": { "description": "Owner commands only: asks the sub for an apply receipt (constants.json peerMessage.receipts). Written only when true.", "const": true }
      }
    }
  }
}
