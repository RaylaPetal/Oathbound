{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oathbound.example/relay/schemas/pair.schema.json",
  "title": "Pair",
  "description": "Server-side pair record activated once both device proofs are observed. Contains no character name, world, or command content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type", "schemaVersion", "pairIdHash", "pairEpoch",
    "ownerDeviceKeyId", "subDeviceKeyId", "createdAt"
  ],
  "properties": {
    "type": { "const": "pair" },
    "schemaVersion": { "const": 1 },
    "pairIdHash": { "$ref": "common.schema.json#/$defs/pairIdHash" },
    "pairEpoch": { "$ref": "common.schema.json#/$defs/pairEpoch" },
    "ownerDeviceKeyId": { "$ref": "common.schema.json#/$defs/deviceKeyId" },
    "subDeviceKeyId": { "$ref": "common.schema.json#/$defs/deviceKeyId" },
    "createdAt": { "$ref": "common.schema.json#/$defs/unixSeconds" },
    "revokedAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/unixSeconds" }, { "type": "null" }] },
    "collarState": { "description": "Latest collar state reported by the pair's Sub device, or null if none.", "enum": ["locked", "unlocked", "broken", null] },
    "collarStateAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/unixSeconds" }, { "type": "null" }] },
    "collarCheckinAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/unixSeconds" }, { "type": "null" }] },
    "catalogMailbox": {
      "description": "The pair epoch's catalog mailbox state, so both members learn from this one poll whether a snapshot is waiting or was collected. exists is false when the Owner has never published a receive key.",
      "type": "object",
      "additionalProperties": false,
      "required": ["exists"],
      "properties": {
        "exists": { "type": "boolean" },
        "receiveKeyId": { "$ref": "catalog-mailbox-key.schema.json#/properties/receiveKeyId" },
        "waitingSnapshotId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/monotonicSequence" }, { "type": "null" }] },
        "lastConsumedSnapshotId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/monotonicSequence" }, { "type": "null" }] },
        "lastUploadAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/unixSeconds" }, { "type": "null" }] }
      }
    }
  }
}
